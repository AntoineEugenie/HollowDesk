@page "/about"

<div class="about-wrapper">

    <div class="about-header">
        <div class="about-header-tag">// DOC.ABOUT</div>
        <h1 class="about-header-title">H.I.A. MANIFESTO</h1>
    </div>

    <div class="about-card">
        <div class="about-card-corner tl"></div>
        <div class="about-card-corner tr"></div>
        <div class="about-card-corner bl"></div>
        <div class="about-card-corner br"></div>

        <div class="about-org-title"># HOLLOW INVESTIGATIVE ASSOCIATION</div>

        <div class="about-meta-grid">
            <div class="about-meta-row">
                <span class="about-meta-label">TERMINAL VERSION</span>
                <span class="about-meta-val">4.1.0-SECURE</span>
            </div>
            <div class="about-meta-row">
                <span class="about-meta-label">REQUIRED CLEARANCE</span>
                <span class="about-meta-val">AGENT / ADMINISTRATOR</span>
            </div>
            <div class="about-meta-row">
                <span class="about-meta-label">SYSTEM STATUS</span>
                <span class="about-meta-val" style="color: var(--green);">● OPERATIONAL</span>
            </div>
        </div>
    </div>

    <!-- Tech stack -->
    <div class="about-section-label">// TERMINAL TECH STACK</div>
    <div class="about-stack">

        <div class="about-stack-item">
            <div class="about-stack-header">
                <span class="about-stack-num">01</span>
                <span class="about-stack-name">.NET MAUI BLAZOR HYBRID</span>
                <span class="about-stack-tag">FRONT-END</span>
            </div>
            <p class="about-stack-desc">Hybrid architecture enabling native OS API access (FilePicker, Environment) while maintaining a fluid web interface and a cathode-ray rendering style.</p>
        </div>

        <div class="about-stack-item">
            <div class="about-stack-header">
                <span class="about-stack-num">02</span>
                <span class="about-stack-name">SUPABASE (POSTGRESQL)</span>
                <span class="about-stack-tag">BACK-END</span>
            </div>
            <p class="about-stack-desc">Full CRUD management of Ethereal entities, cloud-hosted visual archives (Storage) and strict enforcement of security policies (RLS — Row Level Security).</p>
        </div>

        <div class="about-stack-item">
            <div class="about-stack-header">
                <span class="about-stack-num">03</span>
                <span class="about-stack-name">SUPABASE AUTH</span>
                <span class="about-stack-tag">SECURITY</span>
            </div>
            <p class="about-stack-desc">Secure token generation (JWT) and administrative role assignment (RBAC). Two-tier access control: Agent and Administrator clearance levels.</p>
        </div>

    </div>

    <!-- Zero directive -->
    <div class="about-section-label" style="margin-top: 28px;">// ZERO DIRECTIVE</div>
    <div class="about-directive">
        <div class="about-directive-corner tl"></div>
        <div class="about-directive-corner br"></div>
        <p class="about-directive-text">
            "We document what cannot be seen.<br />
            We secure what cannot be understood.<br />
            We purge what threatens reality."
        </p>
        <div class="about-directive-sig">— H.I.A. FOUNDING PROTOCOL</div>
    </div>

</div>

