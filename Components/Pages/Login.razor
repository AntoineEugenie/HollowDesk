@page "/login"
@using HollowDesk.Models
@inject Supabase.Client SupabaseClient
@inject NavigationManager NavigationManager

<div class="login-wrapper">

    <div class="login-deco-left">
        <div class="login-deco-line"></div>
        <div class="login-deco-text">H.I.A. // SECURE NODE</div>
        <div class="login-deco-line"></div>
    </div>

    <div class="login-panel">

        <div class="login-header">
            <div class="login-logo-tag">// HOLLOW INTELLIGENCE ARCHIVE</div>
            <h1 class="login-logo-title">H.I.A.</h1>
            <div class="login-logo-sub">AGENT AUTHENTICATION PROTOCOL</div>
        </div>

        <div class="login-corner tl"></div>
        <div class="login-corner tr"></div>
        <div class="login-corner bl"></div>
        <div class="login-corner br"></div>

        <div class="login-field">
            <label class="login-label">> IDENTIFIER (EMAIL)</label>
            <input type="email" @bind="email" placeholder="agent.name@hia.gov" class="login-input" />
        </div>

        <div class="login-field">
            <label class="login-label">> PASSWORD</label>
            <input type="password" @bind="password" placeholder="••••••••••••" class="login-input" />
        </div>

        <button @onclick="ConnexionAgent" class="login-btn">
            <span class="login-btn-bracket">[</span>
            INITIATE UPLINK
            <span class="login-btn-bracket">]</span>
        </button>

        <div class="login-footer">
            <a href="register" class="login-link">
                › Not yet cleared? Request access
            </a>
        </div>

        @if (!string.IsNullOrEmpty(statut))
        {
            <div class="login-status @(statut.Contains("FAILED") || statut.Contains("ALERT") ? "login-status--error" : "login-status--info")">
                > @statut
            </div>
        }

    </div>

    <div class="login-deco-right">
        <div class="login-deco-line"></div>
        <div class="login-deco-text">ZETA-SECTOR // NODE</div>
        <div class="login-deco-line"></div>
    </div>

</div>

@code {
    private string email = "";
    private string password = "";
    private string statut = "";

    private async Task ConnexionAgent()
    {
        statut = "Establishing connection...";

        try
        {
            var session = await SupabaseClient.Auth.SignIn(email, password);

            if (session != null)
            {
                statut = "Authentication successful. Verifying clearance level...";
                var reponseRole = await SupabaseClient.From<UserRole>().Get();
                var profilAgent = reponseRole.Models.FirstOrDefault();

                if (profilAgent != null)
                {
                    statut = $"Access granted. Role : {profilAgent.Role.ToUpper()}. Redirecting...";
                    NavigationManager.NavigateTo("/dashboard", forceLoad: true);
                }
                else
                {
                    statut = "[ALERT] Connection established, but no role is assigned to this identifier in the user_role table.";
                }
            }
        }
        catch (Exception ex)
        {
            try
            {
                var e = System.Text.Json.Nodes.JsonNode.Parse(ex.Message);
                statut = $"FAILED - Error {e["code"]} {e["error_code"]}: {e["msg"]}";
            }
            catch
            {
                statut = $"Connection failed : {ex.Message}";
            }
        }
    }
}
