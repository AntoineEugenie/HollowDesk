@page "/archive"
@using HollowDesk.Models
@inject Supabase.Client SupabaseClient
@inject NavigationManager NavigationManager

<div class="archive-wrapper">

    <!-- Header -->
    <div class="archive-header">
        <div class="archive-header-left">
            <div class="archive-header-tag">// DB.ARCHIVES</div>
            <h1 class="archive-header-title">REGISTRE DES ÉTHÉRÉENS</h1>
        </div>
        <div class="archive-header-right">
            <span class="archive-count">@EntitiesFiltrees.Count() ENTITÉ(S)</span>
        </div>
    </div>

    <!-- Barre de recherche -->
    <div class="archive-search">
        <span class="archive-search-icon">›</span>
        <input type="text" @bind="searchQuery" @bind:event="oninput"
               placeholder="RECHERCHER — NOM, CODE, FACTION, TYPE..."
               class="archive-search-input" />
        @if (!string.IsNullOrEmpty(searchQuery))
        {
            <button @onclick="() => searchQuery = string.Empty" class="archive-search-clear">✕</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(ErrorStatus))
    {
        <div class="hia-msg-error">@ErrorStatus</div>
    }

    @if (entities.Count == 0)
    {
        <div class="archive-empty">
            <div class="archive-empty-icon">◈</div>
            <div class="archive-empty-text">AUCUN ÉTHÉRÉEN TROUVÉ DANS LES ARCHIVES</div>
            <div class="archive-empty-sub">La base de données est vide ou inaccessible.</div>
        </div>
    }
    else if (!EntitiesFiltrees.Any())
    {
        <div class="archive-empty">
            <div class="archive-empty-icon">◈</div>
            <div class="archive-empty-text">AUCUN RÉSULTAT POUR "@searchQuery"</div>
            <div class="archive-empty-sub">Modifiez votre recherche ou effacez le filtre.</div>
        </div>
    }
    else
    {
        <div class="archive-list">
            @foreach (var entity in EntitiesFiltrees)
            {
                <div class="archive-entry">

                    <div class="archive-entry-portrait">
                        <img src="@entity.ImagePath" alt="@entity.Name" class="archive-entry-img" />
                    </div>

                    <div class="archive-entry-info">
                        <div class="archive-entry-name">@entity.Name.ToUpper()</div>
                        <div class="archive-entry-meta">
                            <span class="archive-entry-codename">// @entity.CodeName</span>
                            <span class="archive-entry-sep">—</span>
                            <span class="archive-entry-faction">@entity.Faction</span>
                        </div>
                        <div class="archive-entry-type">@entity.Type</div>
                    </div>

                    <div class="archive-entry-threat">
                        <span class="hia-threat @GetThreatClass(entity.Dangerosity)">
                            @entity.Dangerosity.ToString().ToUpper()
                        </span>
                    </div>

                    <div class="archive-entry-actions">
                        <a href="/entity/@entity.Id" class="archive-btn-file">
                            [ DOSSIER ]
                        </a>
                        @if (isAdmin)
                        {
                            <button @onclick="() => DeleteEtherren(entity)" class="archive-btn-delete">
                                [ PURGER ]
                            </button>
                        }
                    </div>

                </div>
            }
        </div>
    }

</div>

<style>

</style>

@code {
    private List<Entity> entities = new List<Entity>();
    private string ErrorStatus = "";
    private bool isAdmin = false;
    private string searchQuery = "";

    private IEnumerable<Entity> EntitiesFiltrees => entities.Where(e =>
        string.IsNullOrEmpty(searchQuery) ||
        e.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
        e.CodeName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
        e.Faction.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
        e.Type.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
    );

    private string GetThreatClass(Dangerosity d) => d switch
    {
        Dangerosity.C => "hia-threat-c",
        Dangerosity.B => "hia-threat-b",
        Dangerosity.A => "hia-threat-a",
        Dangerosity.S => "hia-threat-s",
        Dangerosity.SS => "hia-threat-ss",
        _ => "hia-threat-c"
    };

    protected override async Task OnInitializedAsync()
    {
        if (SupabaseClient.Auth.CurrentSession == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            var reponseRole = await SupabaseClient.From<UserRole>().Get();
            var profil = reponseRole.Models.FirstOrDefault();

            if (profil != null && profil.Role?.ToLower() == "admin")
            {
                isAdmin = true;
            }

            await ChargerDonnees();
        }
        catch (Exception ex)
        {
            ErrorStatus = $"[SYSTEM ERROR] {ex.Message}";
        }
    }

    private async Task ChargerDonnees()
    {
        var reponse = await SupabaseClient.From<Entity>().Get();
        entities = reponse.Models ?? new List<Entity>();
    }

    private async Task DeleteEtherren(Entity target)
    {
        bool confirmation = false;

        if (Application.Current?.Windows.Count > 0)
        {
            var pageActuelle = Application.Current.Windows[0].Page;
            if (pageActuelle != null)
            {
                confirmation = await pageActuelle.DisplayAlertAsync(
                    "⚠️ SECURE CLASSIFICATION",
                    $"Do you want to permanently purge {target.Name} from the H.I.A. archives?",
                    "Confirm",
                    "Cancel"
                );
            }
        }

        if (!confirmation) return;

        try
        {
            await SupabaseClient
                .From<Entity>()
                .Filter("id", Postgrest.Constants.Operator.Equals, target.Id)
                .Delete();

            entities.Remove(target);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorStatus = $"[PURGE FAILURE] {ex.Message}";
        }
    }
}
