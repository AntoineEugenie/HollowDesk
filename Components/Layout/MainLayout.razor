@inherits LayoutComponentBase
@inject HollowDesk.Services.ThemeService ThemeService
@implements IDisposable

<div class="hia-root @ThemeService.ThemeClass @(ThemeService.ScanlinesActive ? "scanlines" : "")">

    <div class="hia-layout">

        <aside class="hia-sidebar">
            <NavMenu />
        </aside>

        <div class="hia-main-area">

            <header class="hia-topbar">
                <div class="hia-topbar-left">
                    <span class="hia-topbar-tag">// SYS</span>
                    <span class="hia-topbar-title">H.I.A. TERMINAL</span>
                    <span class="hia-topbar-version">v4.1 — SECURE_MODE</span>
                </div>
                <div class="hia-topbar-right">
                    <span class="hia-status-dot"></span>
                    <span class="hia-status-label">UPLINK ACTIVE</span>
                </div>
            </header>

            <main class="hia-content">
                <article class="px-4">
                    @Body
                </article>
            </main>

        </div>
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += RafraichirInterface;
    }

    private void RafraichirInterface()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= RafraichirInterface;
    }
}
